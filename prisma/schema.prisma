generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  WORKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum FarmStatus {
  ACTIVE
  INACTIVE
}

enum BlockStatus {
  ACTIVE
  INACTIVE
}

enum TreeStatus {
  PRODUCTIVE
  NOT_PRODUCTIVE
  YOUNG
  DEAD
}

enum TreeHealth {
  HEALTHY
  NEEDS_ATTENTION
  SICK
}

enum HarvestGrade {
  GRADE_A
  GRADE_B
  GRADE_C
  REJECTED
}

enum ActivityType {
  WATERING
  FERTILIZATION
  PRUNING
  PEST_CONTROL
  DISEASE_TREATMENT
  CLEANING
  HARVEST_PREPARATION
  OTHER
}

enum ActivityStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum SalesStockMovementType {
  HARVEST_IN
  SALE_OUT
  SALE_CANCELLED_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  E_WALLET
  OTHER
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String
  email        String     @unique
  phone        String?
  passwordHash String
  role         UserRole   @default(WORKER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  harvests     Harvest[]
  activities   Activity[]

  @@index([status])
  @@index([role])
}

model Farm {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  location    String
  area        Decimal      @db.Decimal(12, 2)
  description String?
  status      FarmStatus   @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  blocks      Block[]
  trees       Tree[]
  harvests    Harvest[]
  activities  Activity[]
  expenses    Expense[]

  @@index([status])
  @@index([name])
}

model Block {
  id           String       @id @default(uuid()) @db.Uuid
  farmId       String       @db.Uuid
  name         String
  area         Decimal      @db.Decimal(12, 2)
  mainVariety  String
  plantingYear Int
  status       BlockStatus  @default(ACTIVE)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  farm         Farm         @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  trees        Tree[]
  harvests     Harvest[]
  activities   Activity[]

  @@index([farmId])
  @@index([status])
  @@index([mainVariety])
  @@unique([farmId, name])
}

model Tree {
  id           String      @id @default(uuid()) @db.Uuid
  treeCode     String      @unique
  farmId       String      @db.Uuid
  blockId      String      @db.Uuid
  variety      String
  plantingDate DateTime
  status       TreeStatus  @default(YOUNG)
  health       TreeHealth  @default(HEALTHY)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  farm         Farm        @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  block        Block       @relation(fields: [blockId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  harvests     Harvest[]
  activities   Activity[]

  @@index([farmId])
  @@index([blockId])
  @@index([variety])
  @@index([status])
  @@index([health])
}

model Harvest {
  id           String        @id @default(uuid()) @db.Uuid
  harvestDate  DateTime
  farmId       String        @db.Uuid
  blockId      String        @db.Uuid
  treeId       String?       @db.Uuid
  workerId     String        @db.Uuid
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  farm         Farm          @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  block        Block         @relation(fields: [blockId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tree         Tree?         @relation(fields: [treeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  worker       User          @relation(fields: [workerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items        HarvestItem[]

  @@index([harvestDate])
  @@index([farmId])
  @@index([blockId])
  @@index([treeId])
  @@index([workerId])
}

model HarvestItem {
  id         String       @id @default(uuid()) @db.Uuid
  harvestId  String       @db.Uuid
  variety    String
  grade      HarvestGrade
  fruitCount Int
  weight     Decimal      @db.Decimal(12, 2)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  harvest    Harvest      @relation(fields: [harvestId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([harvestId])
  @@index([variety])
  @@index([grade])
}

model Activity {
  id               String         @id @default(uuid()) @db.Uuid
  type             ActivityType
  farmId           String         @db.Uuid
  blockId          String         @db.Uuid
  treeId           String?        @db.Uuid
  assignedWorkerId String         @db.Uuid
  scheduledDate    DateTime
  status           ActivityStatus @default(SCHEDULED)
  notes            String?
  cost             Decimal        @db.Decimal(12, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  farm             Farm           @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  block            Block          @relation(fields: [blockId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tree             Tree?          @relation(fields: [treeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedWorker   User           @relation(fields: [assignedWorkerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([type])
  @@index([farmId])
  @@index([blockId])
  @@index([treeId])
  @@index([assignedWorkerId])
  @@index([scheduledDate])
  @@index([status])
}

model Expense {
  id            String   @id @default(uuid()) @db.Uuid
  date          DateTime
  category      String
  farmId        String   @db.Uuid
  description   String
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([date])
  @@index([category])
  @@index([farmId])
  @@index([paymentMethod])
}

model InventoryItem {
  id            String                @id @default(uuid()) @db.Uuid
  name          String
  category      String
  unit          String
  minimumStock  Decimal               @db.Decimal(12, 3)
  purchasePrice Decimal               @db.Decimal(12, 2)
  supplier      String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  transactions  InventoryTransaction[]

  @@index([name])
  @@index([category])
  @@index([supplier])
}

model InventoryTransaction {
  id              String                  @id @default(uuid()) @db.Uuid
  inventoryItemId String                  @db.Uuid
  type            InventoryTransactionType
  quantity        Decimal                 @db.Decimal(12, 3)
  reference       String?
  notes           String?
  createdAt       DateTime                @default(now())
  inventoryItem   InventoryItem           @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([inventoryItemId])
  @@index([type])
  @@index([createdAt])
}

model SalesStock {
  id          String               @id @default(uuid()) @db.Uuid
  variety     String
  grade       HarvestGrade
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  movements   SalesStockMovement[]
  saleItems   SaleItem[]

  @@unique([variety, grade])
  @@index([variety])
  @@index([grade])
}

model SalesStockMovement {
  id           String                 @id @default(uuid()) @db.Uuid
  salesStockId String                 @db.Uuid
  type         SalesStockMovementType
  weight       Decimal                @db.Decimal(12, 3)
  reference    String?
  notes        String?
  createdAt    DateTime               @default(now())
  salesStock   SalesStock             @relation(fields: [salesStockId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([salesStockId])
  @@index([type])
  @@index([createdAt])
}

model Customer {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  type          CustomerType
  phone         String?
  email         String?
  address       String?
  contactPerson String?
  notes         String?
  status        CustomerStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sales         Sale[]

  @@index([name])
  @@index([type])
  @@index([status])
  @@index([email])
}

model Sale {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceNumber   String        @unique
  customerId      String        @db.Uuid
  transactionDate DateTime
  status          SaleStatus    @default(DRAFT)
  deliveryMethod  String
  deliveryDate    DateTime?
  deliveryAddress String?
  deliveryCost    Decimal       @db.Decimal(12, 2)
  discount        Decimal       @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items           SaleItem[]
  payments        Payment[]

  @@index([customerId])
  @@index([transactionDate])
  @@index([status])
}

model SaleItem {
  id           String      @id @default(uuid()) @db.Uuid
  saleId       String      @db.Uuid
  salesStockId String      @db.Uuid
  variety      String
  grade        HarvestGrade
  weight       Decimal     @db.Decimal(12, 3)
  pricePerUnit Decimal     @db.Decimal(12, 2)
  discount     Decimal     @db.Decimal(12, 2)
  subtotal     Decimal     @db.Decimal(12, 2)
  sale         Sale        @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  salesStock   SalesStock  @relation(fields: [salesStockId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([saleId])
  @@index([salesStockId])
  @@index([variety])
  @@index([grade])
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  saleId        String        @db.Uuid
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  paymentDate   DateTime
  reference     String?
  notes         String?
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([saleId])
  @@index([paymentDate])
  @@index([paymentMethod])
}
